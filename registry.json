{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "anaphor",
  "homepage": "https://github.com/danfrenette/anaphor",
  "items": [
    {
      "name": "ui",
      "type": "registry:ui",
      "title": "Anaphor UI",
      "description": "Install the complete Anaphor component system.",
      "registryDependencies": [
        "danfrenette/anaphor/style",
        "danfrenette/anaphor/badge",
        "danfrenette/anaphor/button",
        "danfrenette/anaphor/card",
        "danfrenette/anaphor/card-copy-button",
        "danfrenette/anaphor/checkbox",
        "danfrenette/anaphor/field",
        "danfrenette/anaphor/field-feedback",
        "danfrenette/anaphor/input",
        "danfrenette/anaphor/menu",
        "danfrenette/anaphor/morph-surface",
        "danfrenette/anaphor/separator",
        "danfrenette/anaphor/text",
        "danfrenette/anaphor/prose"
      ]
    },
    {
      "name": "style",
      "type": "registry:style",
      "title": "Anaphor Style",
      "description": "Anaphor tokens, typography, fonts, themes, and shared component styles.",
      "dependencies": ["tailwindcss"],
      "files": [
        {
          "path": "packages/design-system/src/styles.css",
          "type": "registry:file",
          "target": "@components/anaphor.css"
        },
        {
          "path": "packages/design-system/src/fonts.css",
          "type": "registry:file",
          "target": "@components/fonts.css"
        },
        {
          "path": "packages/design-system/src/fonts/Inter-LICENSE.txt",
          "type": "registry:file",
          "target": "@components/fonts/Inter-LICENSE.txt"
        },
        {
          "path": "packages/design-system/src/fonts/MagdaCleanMono-download-notice.txt",
          "type": "registry:file",
          "target": "@components/fonts/MagdaCleanMono-download-notice.txt"
        }
      ],
      "docs": "Import the generated Anaphor stylesheet once from your application CSS entry, then add an @source rule for the application's TS/TSX files."
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "packages/design-system/src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@components/lib/utils.ts"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "registryDependencies": ["danfrenette/anaphor/style", "danfrenette/anaphor/utils"],
      "files": [
        {
          "path": "packages/design-system/src/components/badge.tsx",
