{
  "name": "anaphor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @anaphor/demo dev",
    "build": "pnpm --filter @anaphor/demo build",
    "start": "pnpm --filter @anaphor/demo start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --recursive typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:registry": "node scripts/verify-registry.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "^14.6.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "latest",
    "shadcn": "4.21.0",
    "typescript": "^5",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.33.0"
}
